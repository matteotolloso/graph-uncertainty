# --- Top-ups (added 2026-09-30): runs that crashed with "Sum of lower bounds for a node cannot exceed 1" (float32
# rounding of collapsed credal intervals at high lr; fixed in cgnn/uncertainty/entropy.py, known_issues M1) are
# replaced by as many new runs of the same sweep, so every sweep ends with 50 finished runs. No-op if none failed.
# (credal_last-patents started before the fix, hence listed too.)
credal_LJ0_dual_head_detached-coauthor-topup  -                                    gpu  source scripts/campaigns/env.sh && n=$(python scripts/campaigns/count_failed_runs.py graph-uncertainty-v02 2pgfsje8) && if [ "$n" -gt 0 ]; then CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m credal_LJ0_dual_head_detached -d coauthor -p graph-uncertainty-v02 --sweep-id 2pgfsje8 -c "$n" --set deterministic=false; fi
credal_LJ0_dual_head_detached-reddit2-topup   credal_LJ0_dual_head_detached-reddit2  gpu  source scripts/campaigns/env.sh && n=$(python scripts/campaigns/count_failed_runs.py graph-uncertainty-v02 696bd8ui) && if [ "$n" -gt 0 ]; then CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m credal_LJ0_dual_head_detached -d reddit2 -p graph-uncertainty-v02 --sweep-id 696bd8ui -c "$n"; fi
credal_last_dual_head_detached-patents-topup  credal_last_dual_head_detached-patents gpu  source scripts/campaigns/env.sh && n=$(python scripts/campaigns/count_failed_runs.py graph-uncertainty-v02 w4htf29k) && if [ "$n" -gt 0 ]; then CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m credal_last_dual_head_detached -d patents -p graph-uncertainty-v02 --sweep-id w4htf29k -c "$n" --set deterministic=false; fi
