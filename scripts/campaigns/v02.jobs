gnnsafe-arxiv                            vanilla-arxiv                gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m gnnsafe -d arxiv -p graph-uncertainty-v02
