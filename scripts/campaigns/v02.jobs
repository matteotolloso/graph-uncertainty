knn_LJ-arxiv                             vanilla-arxiv                cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m knn_LJ -d arxiv -p graph-uncertainty-v02 --cpu
gebm-arxiv                               vanilla-arxiv                cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m gebm -d arxiv -p graph-uncertainty-v02 --cpu
cagcn-arxiv                              vanilla-arxiv                gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m cagcn -d arxiv -c 30 -p graph-uncertainty-v02
