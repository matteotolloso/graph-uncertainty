# Campaign v0.2: re-run what the audit found affected (docs/known_issues.md). W&B project: graph-uncertainty-v02
# Run:  nohup python scripts/gpu_queue.py scripts/campaigns/v02.jobs --log-dir outputs/logs/v02 --prefer 6 7 \
#         > outputs/logs/v02_queue.log 2>&1 &
# Jobs start in file order when their dependencies are done; at most 2 GPU jobs at a time.
# Patents: deterministic=false (deterministic scatter needs >40 GB for full-graph eval; see known_issues M8).

# --- H1: AUROC saturation. Energy/Mahalanobis/GEBM with exact AUROC on the paper's backbones
# (fixed public splits; CPU as in the original runs: Reddit2 full-graph ~52 GB, Squirrel SAGE).
energy-squirrel                          -                            cpu  source scripts/campaigns/env.sh && cgnn sweep -m energy -d squirrel -p graph-uncertainty-v02 --cpu
mahalanobis-squirrel                     -                            cpu  source scripts/campaigns/env.sh && cgnn sweep -m mahalanobis -d squirrel -p graph-uncertainty-v02 --cpu
gebm-squirrel                            -                            cpu  source scripts/campaigns/env.sh && cgnn sweep -m gebm -d squirrel -p graph-uncertainty-v02 --cpu
energy-reddit2                           -                            cpu  source scripts/campaigns/env.sh && cgnn sweep -m energy -d reddit2 -p graph-uncertainty-v02 --cpu
mahalanobis-reddit2                      -                            cpu  source scripts/campaigns/env.sh && cgnn sweep -m mahalanobis -d reddit2 -p graph-uncertainty-v02 --cpu
gebm-reddit2                             -                            cpu  source scripts/campaigns/env.sh && cgnn sweep -m gebm -d reddit2 -p graph-uncertainty-v02 --cpu

# --- H2 + missing backbones: vanilla backbones with split_seed=0 into checkpoints/v02
vanilla-arxiv                            -                            gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m vanilla -d arxiv -c 50 -p graph-uncertainty-v02
vanilla-coauthor                         -                            gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m vanilla -d coauthor -c 50 -p graph-uncertainty-v02   # done: GCN runs only (SAGE OOM), superseded by -2
# Coauthor again with deterministic=false: in the first sweep every SAGE run went OOM on 40 GB GPUs
vanilla-coauthor-2                       -                            gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m vanilla -d coauthor -c 50 -p graph-uncertainty-v02 --set deterministic=false
vanilla-amazon_ratings                   -                            gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m vanilla -d amazon_ratings -c 50 -p graph-uncertainty-v02
vanilla-roman_empire                     -                            gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m vanilla -d roman_empire -c 50 -p graph-uncertainty-v02
vanilla-patents                          -                            gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m vanilla -d patents -c 50 -p graph-uncertainty-v02 --set deterministic=false

# --- all post-hoc baselines + CaGCN, ensembles, CGNN post train on those backbones
energy-arxiv                             vanilla-arxiv                gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m energy -d arxiv -p graph-uncertainty-v02
odin-arxiv                               vanilla-arxiv                gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m odin -d arxiv -p graph-uncertainty-v02
