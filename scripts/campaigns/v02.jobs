# --- Patents re-runs (added 2026-09-29). odin/mahalanobis-patents: every run with input perturbation OOMed on
# the 40 GB GPU (full-graph input gradient) -> CPU, as the legacy scripts did. knn/knn_LJ-patents: CPU FAISS took
# ~11 h per run (3-4 days per grid) -> exact torch search on GPU (knn_backend=torch, same scores; tests/test_runner.py).
# The replaced sweeps must be tagged `superseded` in W&B once these finish.
odin-patents-cpu                         vanilla-patents              cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m odin -d patents -p graph-uncertainty-v02 --cpu --set deterministic=false
mahalanobis-patents-cpu                  vanilla-patents              cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m mahalanobis -d patents -p graph-uncertainty-v02 --cpu --set deterministic=false
knn-patents-2                            vanilla-patents              gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m knn -d patents -p graph-uncertainty-v02 --set deterministic=false knn_backend=torch
knn_LJ-patents-2                         vanilla-patents              gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn sweep -m knn_LJ -d patents -p graph-uncertainty-v02 --set deterministic=false knn_backend=torch accelerator=gpu

