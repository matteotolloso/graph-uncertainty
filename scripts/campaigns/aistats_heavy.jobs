# Heavy GPU seed replicates (Patents/Reddit2), generated with aistats.jobs. Run in a second queue with
# --gpu-slots 1 --cpu-slots 0 once the v02 queue is finished, so that with the main aistats queue
# (--gpu-slots 1) at most 2 GPUs are used in total.

rep-cagcn-patents                                -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m cagcn -d patents --from-sweep mptou2ma --sweep-project graph-uncertainty-v02 --repeat backbone_rank=0,1,2,3,4 -p graph-uncertainty-aistats --set deterministic=false
rep-credal-patents                               -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/replicates cgnn run -m credal -d patents --from-sweep n8kokz8a --sweep-project graph-uncertainty-v02 --seeds 0 1 2 3 4 -p graph-uncertainty-aistats --set deterministic=false save_checkpoint=false
rep-credal_LJ-patents                            -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/replicates cgnn run -m credal_LJ -d patents --from-sweep mld9bgwb --sweep-project graph-uncertainty-v02 --seeds 0 1 2 3 4 -p graph-uncertainty-aistats --set deterministic=false save_checkpoint=false
rep-credal_LJ_dual_head_detached-patents         -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/replicates cgnn run -m credal_LJ_dual_head_detached -d patents --from-sweep xk9uciv2 --sweep-project graph-uncertainty-v02 --seeds 0 1 2 3 4 -p graph-uncertainty-aistats --set deterministic=false save_checkpoint=false
rep-energy-patents                               -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m energy -d patents --from-sweep kzuow7z5 --sweep-project graph-uncertainty-v02 --repeat backbone_rank=0,1,2,3,4 -p graph-uncertainty-aistats --set deterministic=false
rep-ensemble-patents                             -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m ensemble -d patents --from-sweep arflq7vk --sweep-project graph-uncertainty-v02 -p graph-uncertainty-aistats --set deterministic=false
rep-frozen-patents                               -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m frozen -d patents --from-sweep bgbxmi3y --sweep-project graph-uncertainty-v02 --repeat backbone_rank=0,1,2,3,4 -p graph-uncertainty-aistats --set deterministic=false
rep-gnnsafe-patents                              -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m gnnsafe -d patents --from-sweep h2ajvdga --sweep-project graph-uncertainty-v02 --repeat backbone_rank=0,1,2,3,4 -p graph-uncertainty-aistats --set deterministic=false
rep-knn-patents                                  -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m knn -d patents --from-sweep kj083iys --sweep-project graph-uncertainty-v02 --repeat backbone_rank=0,1,2,3,4 -p graph-uncertainty-aistats --set deterministic=false knn_backend=torch
rep-knn_LJ-patents                               -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m knn_LJ -d patents --from-sweep cwaua81n --sweep-project graph-uncertainty-v02 --repeat backbone_rank=0,1,2,3,4 -p graph-uncertainty-aistats --set deterministic=false knn_backend=torch accelerator=gpu
rep-credal_LJ_dual_head_detached-reddit2         -                                        gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/replicates cgnn run -m credal_LJ_dual_head_detached -d reddit2 --seeds 0 1 2 3 4 -p graph-uncertainty-aistats --set delta=0.998104701529448 gnn_type=GCN hidden_channels=64 lambda_cls=1.7859264818445149 lr=0.007030207902562973 num_layers=2 patience=20 weight_decay=0 save_checkpoint=false

# rank 3 OOMed (fragmentation) after ranks 0-2 finished; re-run ranks 3-4
rep-knn_LJ-patents-r34                           -                                        gpu  source scripts/campaigns/env.sh && PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m knn_LJ -d patents --from-sweep cwaua81n --sweep-project graph-uncertainty-v02 --repeat backbone_rank=3,4 -p graph-uncertainty-aistats --set deterministic=false knn_backend=torch accelerator=gpu
