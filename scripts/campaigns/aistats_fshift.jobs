# AISTATS: test-time node-feature shift (2026-10-02). AU/EU on clean vs feature-shifted ID test nodes,
# sigma in units of the per-feature training std (cgnn/data/perturb.py::shift_test_features).
# W&B project graph-uncertainty-aistats-fshift. CPU (all GPUs busy with other users), 16 threads/job; Reddit2
# CGNN waits for an idle GPU. CGNN: best config, seeds 0-4. Ensemble: M=5 over the existing backbones.
fshift-cgnn-squirrel                 -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift cgnn run -m credal_LJ_dual_head_detached -d squirrel --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift --set progress_bar=false delta=0.5015578678424897 gnn_type=SAGE hidden_channels=64 lambda_cls=1.4572430526647446 lr=0.0008200756435048707 num_layers=2 patience=20 weight_decay=0 save_checkpoint=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-cgnn-amazon_ratings           -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift cgnn run -m credal_LJ_dual_head_detached -d amazon_ratings --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift --set progress_bar=false delta=0.9821548138084352 gnn_type=GCN hidden_channels=64 lambda_cls=1.5257181935549626 lr=0.00022435753113634685 num_layers=2 patience=20 weight_decay=0 save_checkpoint=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-cgnn-roman_empire             -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift cgnn run -m credal_LJ_dual_head_detached -d roman_empire --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift --set progress_bar=false delta=0.5462784754328669 gnn_type=SAGE hidden_channels=64 lambda_cls=0.3952219053156254 lr=0.009316495457210066 num_layers=2 patience=20 weight_decay=0 save_checkpoint=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-cgnn-arxiv                    -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift cgnn run -m credal_LJ_dual_head_detached -d arxiv --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift --from-sweep agbb3lxa --sweep-project graph-uncertainty-v02 --set progress_bar=false save_checkpoint=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-cgnn-coauthor                 -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift cgnn run -m credal_LJ_dual_head_detached -d coauthor --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift --from-sweep amfxfjif --sweep-project graph-uncertainty-v02 --set progress_bar=false deterministic=false save_checkpoint=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-ensemble-amazon_ratings       -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m ensemble -d amazon_ratings --cpu --from-sweep wgnopuii --sweep-project graph-uncertainty-v02 -p graph-uncertainty-aistats-fshift --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-ensemble-roman_empire         -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m ensemble -d roman_empire --cpu --from-sweep fl4ukdrn --sweep-project graph-uncertainty-v02 -p graph-uncertainty-aistats-fshift --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-ensemble-arxiv                -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m ensemble -d arxiv --cpu --from-sweep iw6uxhmj --sweep-project graph-uncertainty-v02 -p graph-uncertainty-aistats-fshift --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-ensemble-coauthor             -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/v02 cgnn run -m ensemble -d coauthor --cpu --from-sweep u8orq57z --sweep-project graph-uncertainty-v02 -p graph-uncertainty-aistats-fshift --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-ensemble-squirrel             -   cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints cgnn run -m ensemble -d squirrel --cpu -p graph-uncertainty-aistats-fshift --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift-cgnn-reddit2                  -   gpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift cgnn run -m credal_LJ_dual_head_detached -d reddit2 --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift --set progress_bar=false delta=0.998104701529448 gnn_type=GCN hidden_channels=64 lambda_cls=1.7859264818445149 lr=0.007030207902562973 num_layers=2 patience=20 weight_decay=0 save_checkpoint=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
