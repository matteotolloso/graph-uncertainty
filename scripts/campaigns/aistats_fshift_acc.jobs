# AISTATS feature-shift ablation, v2 (2026-10-02): models early-stopped on validation ACCURACY.
# v1 (aistats_fshift.jobs) used the OOD-selected models, which on Roman/ArXiv/Squirrel are near-constant
# classifiers (early stopping on val OOD AUROC). Here vanilla (ensemble members) and CGNN share the architecture of
# the CGNN config with the best val accuracy in its sweep; monitor=val_f1 / val_f1_cls, best-val-accuracy epoch.
# Amazon dropped: every CGNN sweep run is a majority-class predictor. CPU. W&B graph-uncertainty-aistats-fshift-acc.
fshift2-vanilla-squirrel             -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m vanilla -d squirrel --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.003692506410911183 weight_decay=0 patience=20 monitor=val_f1 mode=max progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-ensemble-squirrel            fshift2-vanilla-squirrel             cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m ensemble -d squirrel --cpu -p graph-uncertainty-aistats-fshift-acc --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-cgnn-squirrel                -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m credal_LJ_dual_head_detached -d squirrel --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.003692506410911183 weight_decay=0 patience=20 delta=0.5411313884249948 lambda_cls=0.613108899840438 monitor=val_f1_cls mode=max test_ckpt=best save_checkpoint=true progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-vanilla-roman_empire         -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m vanilla -d roman_empire --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.009487384918232271 weight_decay=0 patience=20 monitor=val_f1 mode=max progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-ensemble-roman_empire        fshift2-vanilla-roman_empire         cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m ensemble -d roman_empire --cpu -p graph-uncertainty-aistats-fshift-acc --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-cgnn-roman_empire            -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m credal_LJ_dual_head_detached -d roman_empire --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.009487384918232271 weight_decay=0 patience=20 delta=0.8981064661832949 lambda_cls=1.3325205808055929 monitor=val_f1_cls mode=max test_ckpt=best save_checkpoint=true progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-vanilla-arxiv                -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m vanilla -d arxiv --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.009615929309336926 weight_decay=0 patience=20 monitor=val_f1 mode=max progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-ensemble-arxiv               fshift2-vanilla-arxiv                cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m ensemble -d arxiv --cpu -p graph-uncertainty-aistats-fshift-acc --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-cgnn-arxiv                   -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m credal_LJ_dual_head_detached -d arxiv --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.009615929309336926 weight_decay=0 patience=20 delta=0.7856054712232201 lambda_cls=0.8622023948677667 monitor=val_f1_cls mode=max test_ckpt=best save_checkpoint=true progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-vanilla-coauthor             -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m vanilla -d coauthor --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.005278363507596846 weight_decay=0 patience=20 monitor=val_f1 mode=max progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-ensemble-coauthor            fshift2-vanilla-coauthor             cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m ensemble -d coauthor --cpu -p graph-uncertainty-aistats-fshift-acc --set M=5 deterministic=false progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
fshift2-cgnn-coauthor                -                                    cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/fshift_acc2 cgnn run -m credal_LJ_dual_head_detached -d coauthor --cpu --seeds 0 1 2 3 4 -p graph-uncertainty-aistats-fshift-acc --set gnn_type=SAGE hidden_channels=64 num_layers=2 lr=0.005278363507596846 weight_decay=0 patience=20 delta=0.922540915229157 lambda_cls=0.9900599854082508 monitor=val_f1_cls mode=max test_ckpt=best save_checkpoint=true progress_bar=false "test_feature_noise=[0,0.25,0.5,1,2,4,8]"
