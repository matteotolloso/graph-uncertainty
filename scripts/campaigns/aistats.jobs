# AISTATS extra experiments (2026-10-01). Run with scripts/gpu_queue.py; <= 2 GPUs in total.
# W&B projects: graph-uncertainty-aistats (seed replicates), -csbm (homophily study), -exp1 (label noise/fraction).

# --- Experiment 2: synthetic homophily (CSBM, CPU, small sweeps per level, same protocol as Table 2)
csbm-vanilla-csbm_h1                             -                                        cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/csbm cgnn sweep -m vanilla -d csbm_h1 -c 30 -p graph-uncertainty-aistats-csbm --cpu
csbm-cgnn-csbm_h1                                -                                        cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/csbm cgnn sweep -m credal_LJ_dual_head_detached -d csbm_h1 -c 30 -p graph-uncertainty-aistats-csbm --cpu
csbm-energy-csbm_h1                              csbm-vanilla-csbm_h1                     cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/csbm cgnn sweep -m energy -d csbm_h1 -p graph-uncertainty-aistats-csbm --cpu
csbm-odin-csbm_h1                                csbm-vanilla-csbm_h1                     cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/csbm cgnn sweep -m odin -d csbm_h1 -p graph-uncertainty-aistats-csbm --cpu
csbm-mahalanobis-csbm_h1                         csbm-vanilla-csbm_h1                     cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/csbm cgnn sweep -m mahalanobis -d csbm_h1 -p graph-uncertainty-aistats-csbm --cpu
csbm-knn-csbm_h1                                 csbm-vanilla-csbm_h1                     cpu  source scripts/campaigns/env.sh && CGNN_CKPT_DIR=checkpoints/aistats/csbm cgnn sweep -m knn -d csbm_h1 -p graph-uncertainty-aistats-csbm --cpu
